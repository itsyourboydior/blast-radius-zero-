# ==============================================================================
# Blast Radius Zero - Configuration
# ==============================================================================

# Vultr Serverless Inference (Required for Challenge 1 submission)
# Obtain from Vultr Cloud Portal -> Serverless Inference
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=zephyr-7b-beta

# Optional Fallbacks
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Server Port
PORT=8000
